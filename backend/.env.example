# Copy this file to .env and adjust the values for your machine.

# Port the API listens on
PORT=3000

# PostgreSQL connection: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# `npm run db:setup` creates the database if it does not exist yet.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pharmalink

# Which websites may call the API. * = any (fine for local development).
# In production set it to your frontend's address, e.g. https://pharmalink.rw
CORS_ORIGIN=*
